    {
        "id": "51a4a84073eb67d2",
        "type": "function",
        "z": "b9a028dd32a1df21",
        "name": "decoder",
        "func": "/*\nAngelo De Florio\ndecoder.js\n*/\n\n// Costanti serbatoio\nconst EMPTY_DIST  = 141; // mm\nconst TANK_HEIGHT =  55; // mm\nconst FULL_DIST   = EMPTY_DIST - TANK_HEIGHT;\n\n// Ricezione del payload\nlet distance = Number(msg.payload.distance);\n\nif (Number.isFinite(distance) && distance > 0) {\n    let water_lvl  = Math.max(0, Math.min(TANK_HEIGHT, EMPTY_DIST - distance));\n    let percentage = Math.round((water_lvl / TANK_HEIGHT) * 100);\n\n    node.status(\n        {\n            fill: \"green\",\n            shape: \"dot\",\n            text: `${distance} mm - ${percentage}%`\n        }\n    );\n\n    // InfluxDB\n    const metrics = {\n        measurement: \"water_tank\",\n        payload: {\n            distance: distance,\n            water_lvl: water_lvl,\n            percentage: percentage\n        },\n        tags: {\n            location: \"main_tank\",\n            sensor: \"Milesight EM310-UDL-868M\"\n        },\n        timestamp: new Date()\n    };\n\n\n    // Arduino\n    let arduinoCmd = {};\n    arduinoCmd.payload = `LEVEL:${percentage}\\n`;\n\n    // Smart Socket (DA VEDERE)\n    let socketCmd = {};\n    if (percentage >= 95) {\n        socketCmd.payload = JSON.stringify({\"power\":\"OFF\"});\n    }\n\n    return [metrics, arduinoCmd];\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 740,
        "y": 260,
        "wires": [
